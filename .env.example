# =========================================================================
#  Discord-Version (Branch main)
# =========================================================================
DISCORD_TOKEN=dein-discord-bot-token
DISCORD_CLIENT_ID=deine-application-id
UNB_TOKEN=dein-unbelievaboat-token
# Optional: Slash-Commands sofort auf diesem Server aktiv
DEV_GUILD_ID=

# =========================================================================
#  Fluxer-Version (dieser Branch)  ->  npm run start:fluxer
# =========================================================================
# Bot-Token aus dem Fluxer-Entwicklerbereich
FLUXER_TOKEN=1543641942233976832.9K5_W2vfoIdNBqyBAsZO8rDoMFojgcvFp88iVNIgNI0
# Präfix für die Textbefehle (Fluxer hat keine Slash-Commands)
FLUXER_PREFIX=!

# =========================================================================
#  Wirtschaft (Fluxer bringt sein eigenes Geldsystem mit)
# =========================================================================
# Währungssymbol für die Anzeige
CURRENCY_SYMBOL=🪙
# Fluxer kann Discord-Emojis nicht darstellen. Kommt das Symbol von
# UnbelievaBoat (<:Name:123…>), hier das Fluxer-Gegenstück eintragen:
FLUXER_CURRENCY_SYMBOL=
# Startkapital neuer Spieler
START_CASH=2500

# =========================================================================
#  Optional: Werbe-Nudges bei !work & Co. (nur Discord-Version)
#  Braucht zusätzlich das "Message Content Intent" im Developer Portal.
# =========================================================================
NUDGES=false
NUDGE_CHANCE=0.2
NUDGE_COOLDOWN_MIN=120

# =========================================================================
#  Kanal-Brücke: Nachrichten zwischen Discord und Fluxer spiegeln
#  Beide IDs nötig, sonst bleibt die Brücke aus.
#  Discord braucht dafür das "Message Content Intent" im Developer Portal.
# =========================================================================
# Variante A: nur ein Kanalpaar spiegeln
RELAY_DISCORD_CHANNEL=
RELAY_FLUXER_CHANNEL=

# Variante B: ALLE Kanäle spiegeln. Die Gegenstücke werden über den Namen
# gefunden (Verzierungen wie "💰┃economy" stören nicht), beide Server müssen
# also gleich aufgebaut sein.
RELAY_ALL=false
# Kanäle, die trotzdem privat bleiben (Namen, kommagetrennt)
RELAY_EXCLUDE=admin,intern
# Ausnahmen mit abweichenden Namen: discordId:fluxerId,discordId2:fluxerId2
RELAY_MAP=
