# =========================================================================
#  Discord-Version (Branch main)
# =========================================================================
DISCORD_TOKEN=dein-discord-bot-token
DISCORD_CLIENT_ID=deine-application-id
UNB_TOKEN=dein-unbelievaboat-token
# Optional: Slash-Commands sofort auf diesem Server aktiv
DEV_GUILD_ID=

# =========================================================================
#  Fluxer-Version (dieser Branch)  ->  npm run start:fluxer
# =========================================================================
# Bot-Token aus dem Fluxer-Entwicklerbereich
FLUXER_TOKEN=dein-fluxer-bot-token
# Präfix für die Textbefehle (Fluxer hat keine Slash-Commands)
FLUXER_PREFIX=!

# =========================================================================
#  Wirtschaft (Fluxer bringt sein eigenes Geldsystem mit)
# =========================================================================
# Währungssymbol für die Anzeige
CURRENCY_SYMBOL=🪙
# Fluxer kann Discord-Emojis nicht darstellen. Kommt das Symbol von
# UnbelievaBoat (<:Name:123…>), hier das Fluxer-Gegenstück eintragen –
# als <:Name:ID>, Name:ID oder einfach nur die ID.
# Leer lassen ist okay: dann steht auf Fluxer überall die Münze 🪙.
FLUXER_CURRENCY_SYMBOL=
# Startkapital neuer Spieler
START_CASH=2500

# =========================================================================
#  Staatskasse: der serverweite Topf (src/treasury.js)
# =========================================================================
# Anteile, die bei jeder Buchung ZUSÄTZLICH in die Kasse gelegt werden.
# Der Spieler zahlt davon nichts – der Betrag selbst bleibt unverändert.
# Werte zwischen 0 und 1; ungültige Angaben fallen auf 0.19 / 0.40 zurück.
TREASURY_VAT_RATE=0.19
TREASURY_TAX_RATE=0.40

# =========================================================================
#  Optional: Werbe-Nudges bei !work & Co. (nur Discord-Version)
#  Braucht zusätzlich das "Message Content Intent" im Developer Portal.
# =========================================================================
NUDGES=false
NUDGE_CHANCE=0.2
NUDGE_COOLDOWN_MIN=120

# =========================================================================
# Level-Zuschlag auf UnbelievaBoats Auszahlungen
# =========================================================================
# Der Bot liest !work & Co. mit und legt den Level-Aufschlag drauf.
# Braucht wie die Nudges das Message Content Intent und den Präfix (!work),
# denn UnbelievaBoats Slash-Befehle sind für uns unsichtbar.
WORK_BONUS=false
# Welche Befehle einen Zuschlag bekommen
WORK_BONUS_COMMANDS=work,daily,crime,slut,beg
# Frühestens nach so vielen Minuten gibt es fuer denselben Spieler wieder etwas
WORK_BONUS_COOLDOWN_MIN=20
# Groessere Betraege werden nicht als Auszahlung erkannt (Schutz vor Fehldeutung)
WORK_BONUS_MAX=2000000

# =========================================================================
#  Kanal-Brücke: Nachrichten zwischen Discord und Fluxer spiegeln
#  Beide IDs nötig, sonst bleibt die Brücke aus.
#  Discord braucht dafür das "Message Content Intent" im Developer Portal.
# =========================================================================
# Variante A: nur ein Kanalpaar spiegeln
RELAY_DISCORD_CHANNEL=
RELAY_FLUXER_CHANNEL=

# Variante B: ALLE Kanäle spiegeln. Die Gegenstücke werden über den Namen
# gefunden (Verzierungen wie "💰┃economy" stören nicht), beide Server müssen
# also gleich aufgebaut sein.
RELAY_ALL=false
# Kanäle, die trotzdem privat bleiben (Namen, kommagetrennt)
RELAY_EXCLUDE=admin,intern
# Ausnahmen mit abweichenden Namen: discordId:fluxerId,discordId2:fluxerId2
RELAY_MAP=
# Gespiegelte Nachrichten erscheinen drüben mit Name und Avatar des Absenders
# (über Webhooks; auf Discord braucht der Bot "Webhooks verwalten").
# false = alte Textform "Name: Text" vom Bot.
RELAY_WEBHOOKS=true
# Name des Webhooks selbst – steht NUR in den Kanaleinstellungen, nie an einer
# Nachricht. Daran erkennt der Bot seinen eigenen Webhook wieder.
RELAY_WEBHOOK_NAME=Kanal-Brücke
# Optionaler Zusatz hinter dem Namen, z.B. " (Fluxer)"
RELAY_NAME_SUFFIX=
# Läuft im selben Kanal noch eine andere Brücke: deren Nachrichten ignorieren
RELAY_IGNORE_WEBHOOKS=false
# Spieler treten überall mit ihrem Discord-Namen und -Avatar auf.
# false = jeder sieht aus wie auf der Plattform, von der die Nachricht kommt.
RELAY_DISCORD_IDENTITY=true
# Dazu auch ohne !link: eindeutiger Namenstreffer genügt (nur fürs Aussehen,
# Konto und Geld hängen weiterhin allein an !link).
RELAY_MATCH_NAMES=true

# =========================================================================
#  Rollen-Einkommen (Ersatz für UnbelievaBoats !collect-income)
#  Dessen Konfiguration ist über die API nicht lesbar, deshalb hier eigene.
#  Format: <rollen-id>:<betrag>,<rollen-id>:<betrag>
# =========================================================================
INCOME_ROLES=
INCOME_INTERVAL_HOURS=24
